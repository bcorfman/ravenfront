#:kivy 1.11.0
#:import FadeTransition kivy.uix.screenmanager.FadeTransition

<ScreenManagement>:
    transition: FadeTransition()
    WelcomeScreen:
    MainScreen:
    SettingsScreen:

<WelcomeScreen>:
    name: "welcome"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: root.pos
            size: root.size

    Label:
        text_size: root.size
        halign: 'center'
        valign: 'middle'
        font_name: 'data/font/helvetica.ttf'
        font_size: 40
        color: [0, 0, 0, 1]
        text: "Welcome!"

<MainScreen>:
    name: "main"
    canvas.before:
        Rectangle:
            pos: self.pos
            size: self.size
            source: "data/back.png"

<MainLayout>:
    BoxLayout:
        pos: root.pos
        size_hint: 1,1
        id: MainBox
        orientation: "horizontal" if root.width >= root.height else "vertical"
        spacing: -2
        GridLayout:
            id: TableSection
            cols: 1
            rows: 1
            spacing: -2
            size_hint: (.8, 1) if MainBox.orientation == 'horizontal' else (1, .8)
            Table:
                id: MainTable

        BoxLayout:
            id: ButtonsSection
            orientation: "vertical"
            size_hint: (.2, 1) if MainBox.orientation == 'horizontal' else (1, .2)
            padding: 20
            spacing: 30
            NewGameButton:
                text: "New Game"
                on_release: app.run_coroutine(root.game.new_game())
            Button:
                id: "draw_button"
                size_hint: (1, .25)
                background_color: 0.8, 0.8, 0.8, 1
                background_normal: ""
                text: "Draw?"
                color: 0, 0, 0, 1
                bold: True
            Button:
                id: "settings_button"
                size_hint: (1, .25)
                background_color: 0.8, 0.8, 0.8, 1
                background_normal: ""
                text: "Settings"
                color: 0, 0, 0, 1
                bold: True
            Widget:

<Table>:
    spacing: 0
    padding: 0
    cols: 8
    rows: 8
    size_hint: (1, 1)

<SquareImage>:
    size: root.size
    pos: root.pos
    Label: 
        text: root.square_number
        font_size: '8sp'
        color: .8235, .7059, .549, 1  # Tan color for the text
        pos_hint: {"right": 0.95, 'bottom': 0.05}
        size_hint: None, None
        size: self.texture_size

<NewGameButton>:
    id: "new_game_button"
    size_hint: (1, .25)
    background_color: 0.8, 0.8, 0.8, 1
    background_normal: ""
    text: "New Game"
    color: 0, 0, 0, 1
    bold: True

<StateAlert>:
    title: "State Alert"
    size_hint: (None, None)
    size: (500, 300)
    auto_dismiss: False